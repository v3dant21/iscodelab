POSTGRES_PASSWORD=local-demo-only
DEMO_PASSWORD=DemoPass123!
ALLOW_MOCK_PAYMENTS=true
SECURE_COOKIES=false
APP_ORIGIN=http://localhost:3000

# Google Identity Services web client ID (public, no client secret needed)
GOOGLE_CLIENT_ID=
# Public origin for canonical URLs and sitemap when deploying
SITE_URL=http://localhost:3000
# Optional HTTPS bridge to your SMS/WhatsApp provider. Leave blank until configured.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Required for encrypted personal data. Generate unique keys; never commit real keys.
PII_ENCRYPTION_KEYS=
PII_LOOKUP_KEY=
# Transactional email adapter (optional until a verified sender is configured)
RESEND_API_KEY=
EMAIL_FROM=
